; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="灰烬边境：星陨纪事 · 原生电脑版"
config/description="六地归途 · 完整星钟故事"
config/icon="res://assets/ui/branding/logo.svg"
config/windows_native_icon="res://assets/ui/branding/logo.ico"
run/main_scene="res://scenes/bootstrap.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="AshenFrontierDesktopGodot"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/min_width=960
window/size/min_height=540

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-mcp/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)
